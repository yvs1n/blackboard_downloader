{
  "manifest_version": 3,
  "name": "Blackboard Course Downloader & Exporter",
  "description": "Download and back up Blackboard Learn (Ultra & Original) course materials, slides, documents, announcements, and grades into organized ZIPs or folders.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "downloads",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "client-zip.min.js",
        "turndown.min.js",
        "turndown-plugin-gfm.min.js",
        "helpers.js",
        "detector.js",
        "blackboard-api.js",
        "ui.js",
        "downloader.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon-128.png",
        "icons/icon.svg"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Blackboard Course Downloader"
  }
}

